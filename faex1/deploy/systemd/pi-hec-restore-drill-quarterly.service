[Unit]
Description=Quarterly clean-host restore drill (read-only)

[Service]
Type=oneshot
User=pi-hec-backup
Group=pi-hec-backup
ExecStartPre=/usr/local/bin/node /opt/pi-hec/faex1/deploy/systemd/load-host-config.ts /etc/pi-hec/host-config.json /etc/pi-hec/host-config.pub.pem host-cfg-1
ExecStart=/usr/local/bin/node /opt/pi-hec/faex1/deploy/backup/run-scheduled.ts quarterly-restore-drill
NoNewPrivileges=true
UMask=0077
