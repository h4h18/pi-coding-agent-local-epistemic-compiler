[Unit]
Description=Rotate Pi HEC mTLS leaves (admin, broker, runner, worker, server, ca)

[Service]
Type=oneshot
User=pi-hec-control
Group=pi-hec-control
ExecStartPre=/usr/local/bin/node /opt/pi-hec/faex1/deploy/systemd/load-host-config.ts /etc/pi-hec/host-config.json /etc/pi-hec/host-config.pub.pem host-cfg-1
ExecStart=/usr/local/bin/node /opt/pi-hec/faex1/deploy/systemd/rotate-mtls-impl.ts /var/lib/pi-hec/pki
NoNewPrivileges=true
UMask=0077
