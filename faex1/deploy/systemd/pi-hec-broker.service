[Unit]
Description=Pi HEC secret broker
After=pi-hec-control.service
Requires=pi-hec-control.service

[Service]
Type=simple
User=pi-hec-broker
Group=pi-hec-broker
ExecStartPre=/usr/bin/node /opt/pi-hec/deploy/fa-ex1/systemd/load-host-config.ts /etc/pi-hec/host-config.json /etc/pi-hec/host-config.pub.pem host-cfg-1
ExecStart=/usr/bin/node /opt/pi-hec/apps/secret-broker/src/main.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
