{
  "name": "pi-hec",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "check:deps": "node scripts/check-dependency-graph.ts && node scripts/qualify-versions.ts",
    "lint": "eslint . && cargo fmt --all -- --check",
    "typecheck": "tsc -b && tsc -p tsconfig.eslint.json",
    "test": "vitest run && pnpm test:evaluation && pnpm test:security && node --test test/policy/dependency-graph.test.ts test/policy/qualify-versions.test.ts test/policy/versions-lock.test.ts test/policy/smoke-import.test.ts && cargo nextest run --workspace",
    "test:evaluation": "vitest run --config vitest.evaluation.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "build": "tsc -b && cargo build --workspace --release",
    "check": "pnpm check:deps && pnpm lint && pnpm typecheck && pnpm test && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@pi-hec/contracts": "workspace:0.0.0",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typebox": "1.3.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
