[Unit]
Description=Pi HEC control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi-hec-control
Group=pi-hec-control
ExecStartPre=/usr/bin/node /opt/pi-hec/deploy/fa-ex1/systemd/load-host-config.ts /etc/pi-hec/host-config.json /etc/pi-hec/host-config.pub.pem host-cfg-1
ExecStart=/usr/bin/node /opt/pi-hec/apps/control-plane/src/main.ts
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi-hec/control /var/lib/pi-hec/cas
UMask=0077

[Install]
WantedBy=multi-user.target
