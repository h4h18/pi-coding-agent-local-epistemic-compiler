[Unit]
Description=Pi HEC context and verification workers
After=pi-hec-control.service

[Service]
Type=simple
User=pi-hec-worker
Group=pi-hec-worker
ExecStartPre=/usr/bin/node /opt/pi-hec/deploy/fa-ex1/systemd/load-host-config.ts /etc/pi-hec/host-config.json /etc/pi-hec/host-config.pub.pem host-cfg-1
ExecStart=/usr/bin/node /opt/pi-hec/apps/context-worker/src/index.ts
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
