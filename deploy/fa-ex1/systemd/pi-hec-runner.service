[Unit]
Description=Pi HEC runner
After=pi-hec-control.service

[Service]
Type=simple
User=pi-hec-runner
Group=pi-hec-runner
ExecStartPre=/usr/bin/node /opt/pi-hec/deploy/fa-ex1/systemd/load-host-config.ts /etc/pi-hec/host-config.json /etc/pi-hec/host-config.pub.pem host-cfg-1
ExecStart=/usr/bin/node /opt/pi-hec/native/runner
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
